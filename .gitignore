# Local mode's owner token and its temporary name (ADR 0022). The relay refuses
# a token directory inside the checkout; this keeps one a bug or a failed test
# left behind from being staged.
owner-token
.owner-token.*.tmp
# pnpm record:map-demo's files for review: the take, its poster and a still
# of each scene. A take within budget is copied to apps/map-demo/media/,
# which is tracked; these stay out.
apps/map-demo/recording/
test-results/
playwright-report/
blob-report/
.cache/
*.log
