# Copy to .env for local development. .env is ignored by git; never commit real values.

# Dev-token auth for the relay (required by pnpm dev): comma-separated user=token
# pairs, each token 24 or more random printable characters. MCP clients send
# "Authorization: Bearer <token>". Generate a token with:
#   node -e "console.log(require('node:crypto').randomBytes(24).toString('base64url'))"
# and write the line as, for example, TABDOCK_DEV_TOKENS=alice=<token>,bob=<other token>
# Ignored while TABDOCK_PUBLIC_URL is set: a public relay accepts only OAuth tokens.
TABDOCK_DEV_TOKENS=

# Public URL mode (ADR 0014), for Claude to reach the relay through a tunnel.
# Leave these five empty for local work with dev tokens. With
# TABDOCK_PUBLIC_URL set, the relay still listens on loopback, signs people in
# only through OAuth (dev tokens are refused), needs TABDOCK_ALLOWED_ORIGINS
# like production, lets pages attach only from this machine, and serves the QR
# pairing page at <TABDOCK_PUBLIC_URL>/pair. pnpm dev:public starts it with the
# demo board, names any of these six that is missing, and prints the connector
# URL and the values to enter at the provider (never a secret).
# The https origin the tunnel serves, with no path, for example
# https://<your static domain>.ngrok-free.app. The connector URL is this plus /mcp.
TABDOCK_PUBLIC_URL=
# The identity provider's issuer, exactly as its metadata states it, for example
# https://<your subdomain>.authkit.app. At start the relay checks that the
# provider offers S256 PKCE and either client ID metadata documents or dynamic
# registration, and refuses to start otherwise. At the provider, register
# <TABDOCK_PUBLIC_URL>/mcp as the resource its access tokens are issued for.
TABDOCK_OAUTH_ISSUER=
# Who may use the relay: comma-separated sub=userId:Display Name entries. sub is
# the person's subject at the provider (in WorkOS, the user's ID, user_...);
# userId is 1 to 64 letters, digits, '_' or '-'; the display name is optional
# and may not contain a comma. Anyone else who signs in is refused with 403.
# For example TABDOCK_OAUTH_USERS=user_01ABC=alice:Alice,user_01DEF=bob:Bob
TABDOCK_OAUTH_USERS=
# The relay's own client at the same provider, which the QR page at /pair
# signs a phone's browser in with (authorization code with PKCE). Register it
# at the provider as a confidential client whose redirect URI is
# <TABDOCK_PUBLIC_URL>/pair/callback, and paste its id and secret here. Both
# are required with TABDOCK_PUBLIC_URL; the secret never leaves this file.
TABDOCK_PAIR_CLIENT_ID=
TABDOCK_PAIR_CLIENT_SECRET=

# Relay address. Loopback only (127.0.0.1, ::1 or localhost) until TLS arrives in M4.
TABDOCK_HOST=127.0.0.1
TABDOCK_PORT=8787

# development or production. Production, and public URL mode, need TABDOCK_ALLOWED_ORIGINS.
TABDOCK_ENV=development

# Comma-separated page origins allowed to open the relay's page socket. Empty in
# development means http and https on localhost, 127.0.0.1 and [::1] at any port.
# Production and public URL mode need it listed; for pnpm dev:public with the
# demo board, that is http://127.0.0.1:5173 (or the DEMO_PORT you chose).
TABDOCK_ALLOWED_ORIGINS=

# Development only: 1 lets a page socket in without an Origin header (a Node
# script rather than a browser). Leave it at 0 for anything a browser uses.
TABDOCK_DEV_ALLOW_NO_ORIGIN=0

# Optional section 9 limits and idle lifetimes (ADR 0009). Empty means the
# default shown in parentheses.
# MCP sessions of 2025-era clients per user (20) and in total (1000).
TABDOCK_MAX_SESSIONS_PER_USER=
TABDOCK_MAX_SESSIONS=
# Users attached to one page (10); calls per user per page per minute (120);
# mutating calls waiting their turn on one page (32).
TABDOCK_MAX_USERS_PER_PAGE=
TABDOCK_MAX_CALLS_PER_MINUTE=
TABDOCK_MAX_QUEUE_DEPTH=
# Page sockets open from one address (20); page sessions, asleep ones included,
# created from one address (20) and in total (1000).
TABDOCK_MAX_PAGE_SOCKETS_PER_ADDRESS=
TABDOCK_MAX_PAGE_SESSIONS_PER_ADDRESS=
TABDOCK_MAX_PAGE_SESSIONS=
# An idle MCP session closes after this many minutes (30); an unused attachment
# expires after this many (480, which is 8 hours).
TABDOCK_SESSION_IDLE_MINUTES=
TABDOCK_ATTACHMENT_IDLE_MINUTES=

# The M3 spike's measurements (ADR 0014): 1 logs every tools/list, every stream
# a client opens, each call's relay timestamps and the pairing milestones, adds
# timestamps to call_page_tool results, and lets you add a marker tool from the
# relay's terminal (type add, remove or status). Leave it at 0 otherwise;
# production refuses to start with it.
TABDOCK_SPIKE=0
# Optional, for pnpm spike:latency only. A local relay's dev token to time with
# instead of the first in TABDOCK_DEV_TOKENS; and, for --public, a client the
# provider already knows with a loopback redirect, instead of registering one.
TABDOCK_SPIKE_TOKEN=
TABDOCK_SPIKE_CLIENT_ID=

# Port for the demo page dev server.
DEMO_PORT=5173
