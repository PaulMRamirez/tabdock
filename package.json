{
  "name": "tabdock-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Tabdock lets MCP clients attach to a live web page through one stable relay URL.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "node scripts/dev.ts",
    "dev:public": "node scripts/dev.ts --public",
    "dev:demo": "pnpm --filter @tabdock/demo dev",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json && tsc -p scripts/spike/tsconfig.json && pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:e2e": "pnpm --filter @tabdock/e2e test:e2e",
    "demo:m0": "pnpm --filter @tabdock/e2e demo:m0",
    "demo:m1": "pnpm --filter @tabdock/e2e demo:m1",
    "demo:m2": "pnpm --filter @tabdock/e2e demo:m2",
    "demo:m3": "pnpm --filter @tabdock/e2e demo:m3",
    "spike:latency": "node scripts/spike/latency.ts",
    "spike:soak": "node scripts/spike/soak.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
